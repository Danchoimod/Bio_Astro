---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/business/Navbar.astro';
import Hero from '../components/business/Hero.astro';
import Works from '../components/business/Works.astro';
import Skills from '../components/business/Skills.astro';
import Experience from '../components/business/Experience.astro';
import Footer from '../components/business/Footer.astro';
import { businessData } from '../data/business';
---

<Layout title={`${businessData.name} — ${businessData.headline}`} description={businessData.summary}>
  <div class="min-h-screen bg-white dark:bg-black text-[#1a1b23] dark:text-white transition-colors duration-300 relative selection:bg-[#0061ff] selection:text-white font-['Be_Vietnam_Pro',sans-serif]">
    <!-- Navbar -->
    <Navbar businessData={businessData} />

    <!-- Hero Section -->
    <Hero businessData={businessData} />

    <!-- Works & Projects Section -->
    <Works links={businessData.links} />

    <!-- Skills Section -->
    <Skills skills={businessData.skills} />

    <!-- Experience Section -->
    <Experience experience={businessData.experience} />

    <!-- Footer -->
    <Footer businessData={businessData} />
  </div>
</Layout>

<script>
  // Dark/Light Theme Toggle
  const themeToggle = document.getElementById('theme-toggle');
  
  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  themeToggle?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('color-theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('color-theme', 'dark');
    }
  });
</script>
