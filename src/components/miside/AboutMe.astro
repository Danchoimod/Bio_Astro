---
import Icon from "../Icon.astro";
import type { BioConfig } from "../../data/bio";

interface Props {
  bioData: BioConfig;
}

const { bioData } = Astro.props;

const toolboxSkills = [
  { name: "TypeScript", level: "Core" },
  { name: "JavaScript (ES6+)", level: "Core" },
  { name: "Node.js", level: "Core" },
  { name: "PostgreSQL", level: "Core" },
  { name: "Docker", level: "Core" },
  { name: "Linux / Ubuntu Server", level: "Core" },
  { name: "SQL", level: "Core" },
  { name: "RESTful APIs", level: "Core" },
  { name: "Git & GitHub", level: "Core" },
  { name: "Redis", level: "Experienced" },
  { name: "Express.js", level: "Experienced" },
  { name: "Prisma ORM", level: "Experienced" },
  { name: "Web Security & Auth", level: "Experienced" },
  { name: "Astro", level: "Experienced" },
  { name: "React", level: "Experienced" },
  { name: "Tailwind CSS", level: "Experienced" },
  { name: "Vercel", level: "Experienced" },
  { name: "Nginx", level: "Experienced" },
  { name: "Vite", level: "Experienced" },
  { name: "Python", level: "Familiar" },
  { name: "CI / CD Pipelines", level: "Familiar" },
  { name: "Next.js", level: "Familiar" },
];
---

<!-- MiSide About Me Section -->
<section class="w-full max-w-6xl mx-auto py-16 sm:py-24 z-10 space-y-12">
  <!-- Section Title with MiSide Neon Pink Glow -->
  <div class="flex items-center gap-3">
    <span
      class="w-3 h-3 rounded-full bg-pink-500 shadow-[0_0_10px_rgba(236,72,153,0.9)] animate-pulse"
    ></span>
    <h2
      class="text-2xl sm:text-3xl font-black text-white tracking-wide uppercase font-['Fredoka',sans-serif] flex items-center gap-2"
    >
      <span>❖ ABOUT ME</span>
      <span class="text-pink-400 text-sm font-mono font-normal">/ OVERVIEW</span
      >
    </h2>
  </div>

  <!-- Main About Bio Card -->
  <div
    class="rounded-3xl bg-[#130317]/80 backdrop-blur-2xl border border-pink-500/20 p-6 sm:p-10 shadow-2xl shadow-black/80 space-y-6"
  >
    <div class="space-y-4">
      <h3
        class="text-xl sm:text-2xl font-bold text-pink-100 flex items-center gap-2 font-['Fredoka',sans-serif]"
      >
        <span>Welcome to the world of</span>
        <span class="text-pink-400 underline decoration-pink-500/40"
          >{bioData.name}</span
        >!
      </h3>

      <p
        class="text-sm sm:text-base text-pink-200/80 leading-relaxed font-normal"
      >
        I am a software developer focusing on backend architectures, systems
        engineering, and security. When I'm not writing code, I love diving into
        retro and psychological horror games like MiSide.
      </p>
    </div>

    <!-- Quick Info Tags -->
    <div
      class="pt-6 border-t border-pink-500/15 flex flex-wrap items-center justify-between gap-4 text-xs font-mono"
    >
      <div class="flex items-center gap-2 text-pink-300/80">
        <span class="text-pink-400">❖ STATUS:</span>
        <span class="text-white font-bold">{bioData.status.label}</span>
      </div>
    </div>
  </div>

  <!-- MiSide Toolbox Section: Direct Single Card (No Tabs) -->
  <div class="space-y-6">
    <div class="flex items-center gap-3">
      <span
        class="w-3 h-3 rounded-full bg-pink-500 shadow-[0_0_10px_rgba(236,72,153,0.9)] animate-pulse"
      ></span>
      <h3
        class="text-xl sm:text-2xl font-black text-white tracking-wide uppercase font-['Fredoka',sans-serif] flex items-center gap-2"
      >
        <span>❖ TOOLBOX & TECH STACK</span>
        <span class="text-pink-400 text-xs font-mono font-normal">/ SKILLS</span
        >
      </h3>
    </div>

    <!-- Single Unified Container Card -->
    <div
      class="rounded-3xl bg-[#130317]/80 backdrop-blur-2xl border border-pink-500/20 p-6 sm:p-8 shadow-2xl shadow-black/80 space-y-4"
    >
      <div class="flex flex-wrap gap-2.5">
        {
          toolboxSkills.map((skill) => (
            <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-black/50 border border-pink-500/15 hover:border-pink-400 hover:bg-pink-950/40 hover:shadow-[0_0_12px_rgba(236,72,153,0.35)] transition-all duration-200 group cursor-default">
              <span class="text-xs sm:text-sm text-pink-100 group-hover:text-white font-medium">
                {skill.name}
              </span>
              <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-pink-500/15 text-pink-300 group-hover:text-pink-200 group-hover:bg-pink-500/25 transition-colors">
                {skill.level}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Footer signature for MiSide theme -->
  <div
    class="text-center pt-8 border-t border-pink-500/10 text-xs font-mono text-pink-300/50"
  >
    <p>
      © {new Date().getFullYear()}
      {} Designed by {bioData.name}
    </p>
  </div>
</section>
