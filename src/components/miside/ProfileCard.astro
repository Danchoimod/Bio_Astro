---
import type { BioConfig } from '../../data/bio';

interface Props {
  bioData: BioConfig;
  avatarSrc: string;
}

const { bioData, avatarSrc } = Astro.props;
---

<div class="lg:col-span-7 xl:col-span-8 flex flex-col w-full">
  <!-- Breadcrumb / Category Tags -->
  {bioData.tags && bioData.tags.length > 0 && (
    <div class="flex items-center gap-2 text-[11px] sm:text-xs font-mono font-bold tracking-widest text-pink-400 uppercase mb-3 px-1">
      {bioData.tags.map((tag, idx, arr) => (
        <>
          <span class="hover:text-pink-300 transition-colors cursor-default">{tag}</span>
          {idx < arr.length - 1 && <span class="text-white/30">/</span>}
        </>
      ))}
    </div>
  )}

  <!-- Main Profile Card -->
  <div class="rounded-3xl bg-[#130317]/85 backdrop-blur-2xl border border-pink-500/20 shadow-2xl overflow-hidden shadow-black/80 w-full">
    <!-- Card Top Banner Header -->
    <div class="h-32 sm:h-40 w-full bg-gradient-to-tr from-[#1b0321] via-[#2a0833] to-[#3a0947]/70 border-b border-pink-500/15 relative overflow-hidden">
      <div class="absolute inset-0 bg-radial-[at_top_right] from-pink-500/15 via-transparent to-transparent"></div>
    </div>

    <!-- Card Body -->
    <div class="p-6 sm:p-8 -mt-16 sm:-mt-20 relative">
      <!-- Top Row inside Card: Badge + Status Dot -->
      <div class="flex items-center justify-between text-[11px] font-mono tracking-wider mb-5">
        <span class="text-pink-300/60 uppercase font-semibold">
          {bioData.badge}
        </span>

        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500 shadow-[0_0_8px_rgba(236,72,153,0.9)]"></span>
          </span>
          <span class="text-pink-400 uppercase font-bold text-[10px] sm:text-[11px] tracking-widest">
            {bioData.status.label}
          </span>
        </div>
      </div>

      <!-- Avatar & Greeting Row -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-6 mb-4">
        <!-- Big Avatar with rounded square border & ring glow -->
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden p-0.5 bg-gradient-to-b from-pink-500/30 to-pink-500/10 border border-pink-400/30 shadow-xl flex-shrink-0 group">
          <img
            src={avatarSrc}
            alt={bioData.name}
            class="w-full h-full object-cover rounded-[14px] group-hover:scale-105 transition-transform duration-300"
          />
        </div>

        <!-- Greeting headline with Typewriter & Blinking Long Underscore -->
        <div class="flex-1 min-w-0">
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white flex items-baseline gap-1 font-['Fredoka',sans-serif]">
            <span id="typewriter-text" data-text={bioData.greeting}></span>
            <span id="typewriter-cursor" class="inline-block w-6 sm:w-10 h-1.5 sm:h-2 bg-pink-400 ml-1 rounded-sm shadow-[0_0_8px_rgba(244,114,182,0.9)] cursor-blink"></span>
          </h1>
        </div>
      </div>

      <!-- Description / Bio text -->
      <p class="text-sm sm:text-base text-pink-100/90 leading-relaxed max-w-xl font-medium mt-2">
        {bioData.bio}
      </p>

      <!-- Status / Activity banner -->
      <div class="mt-4 flex items-center gap-2 text-xs sm:text-sm font-mono text-pink-300/80">
        <span class="text-pink-400 font-black uppercase tracking-wider text-[11px] sm:text-xs">
          {bioData.activity.prefix}
        </span>
        <span class="text-pink-100 truncate font-semibold">
          {bioData.activity.text}
        </span>
      </div>
    </div>
  </div>
</div>
