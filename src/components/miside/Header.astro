---
import Icon from '../Icon.astro';
import type { BioConfig } from '../../data/bio';

interface Props {
  signature: string;
  avatarSrc: string;
  name: string;
}

const { signature, avatarSrc, name } = Astro.props;
---

<header class="w-full max-w-6xl mx-auto flex items-center justify-between z-20">
  <!-- Left: Mini Avatar & Signature -->
  <a href="/miside" class="flex items-center gap-3 group">
    <div class="w-9 h-9 rounded-full overflow-hidden border border-pink-400/30 p-0.5 bg-black/40 backdrop-blur-md transition group-hover:scale-105 group-hover:border-pink-400/60">
      <img
        src={avatarSrc}
        alt={name}
        class="w-full h-full object-cover rounded-full"
      />
    </div>
    <span class="font-['Caveat',cursive] text-2xl text-pink-200/90 tracking-wide transition group-hover:text-pink-100">
      {signature}
    </span>
  </a>

  <!-- Right: Action buttons (Menu) -->
  <div class="flex items-center gap-2.5 relative">
    <!-- Menu button (Hamburger 3 lines - Pink MiSide Style) -->
    <button
      type="button"
      id="menu-btn"
      aria-label="Open Menu"
      class="w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-full bg-[#1b0422]/90 hover:bg-pink-600/30 border border-pink-500/40 hover:border-pink-400 text-pink-300 hover:text-white transition-all cursor-pointer backdrop-blur-md shadow-lg shadow-pink-500/20 hover:shadow-pink-500/40 hover:scale-105 group"
    >
      <span class="w-4 h-0.5 bg-pink-400 group-hover:bg-pink-200 transition-colors rounded-full shadow-[0_0_6px_rgba(244,114,182,0.8)]"></span>
      <span class="w-4 h-0.5 bg-pink-400 group-hover:bg-pink-200 transition-colors rounded-full shadow-[0_0_6px_rgba(244,114,182,0.8)]"></span>
      <span class="w-4 h-0.5 bg-pink-400 group-hover:bg-pink-200 transition-colors rounded-full shadow-[0_0_6px_rgba(244,114,182,0.8)]"></span>
    </button>
  </div>
</header>
