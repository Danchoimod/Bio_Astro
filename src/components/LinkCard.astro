---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  url: string;
  icon?: string;
  featured?: boolean;
}

const { title, description, url, icon, featured = false } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class={`group relative flex items-center justify-between p-4 sm:p-5 rounded-2xl border transition-all duration-300 w-full overflow-hidden ${
    featured
      ? 'bg-gradient-to-r from-indigo-900/40 via-purple-900/30 to-slate-900/50 border-indigo-500/40 shadow-lg shadow-indigo-500/10 hover:border-indigo-400 hover:shadow-indigo-500/25 hover:-translate-y-0.5'
      : 'bg-slate-900/40 border-slate-800/80 hover:bg-slate-800/60 hover:border-slate-700 hover:-translate-y-0.5'
  }`}
>
  {featured && (
    <div class="absolute -right-8 -top-8 w-24 h-24 bg-indigo-500/15 rounded-full blur-xl pointer-events-none group-hover:bg-indigo-500/25 transition-all"></div>
  )}

  <div class="flex items-center gap-4 min-w-0">
    {icon && (
      <div class={`flex-shrink-0 w-11 h-11 rounded-xl flex items-center justify-center transition-colors duration-300 ${
        featured 
          ? 'bg-indigo-500/20 text-indigo-300 group-hover:bg-indigo-500 group-hover:text-white' 
          : 'bg-slate-800 text-slate-300 group-hover:bg-indigo-600/20 group-hover:text-indigo-300'
      }`}>
        <Icon name={icon} className="w-5 h-5" />
      </div>
    )}

    <div class="min-w-0 text-left">
      <div class="flex items-center gap-2">
        <h3 class="font-semibold text-slate-100 text-base group-hover:text-indigo-300 transition-colors truncate">
          {title}
        </h3>
        {featured && (
          <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-300 bg-indigo-500/20 rounded-full border border-indigo-500/30 flex-shrink-0">
            Hot
          </span>
        )}
      </div>
      {description && (
        <p class="text-xs sm:text-sm text-slate-400 mt-0.5 line-clamp-1 group-hover:text-slate-300 transition-colors">
          {description}
        </p>
      )}
    </div>
  </div>

  <div class="flex-shrink-0 ml-3 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all duration-300">
    <Icon name="external-link" className="w-4 h-4" />
  </div>
</a>
