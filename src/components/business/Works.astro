---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  about: string;
  featuredProject: BusinessBioConfig['featuredProject'];
}

const { about, featuredProject } = Astro.props;
---

<!-- About Me Section -->
<section class="mb-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white mb-6 tracking-tight">
    About Me
  </h2>
  <div class="bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xs">
    <p class="text-[#64748b] dark:text-slate-400 text-base sm:text-lg leading-relaxed">
      {about}
    </p>
  </div>
</section>

<!-- Featured Project Section -->
<section id="project" class="mb-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white mb-6 tracking-tight">
    Featured Project
  </h2>
  
  <div class="bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-xs">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-5">
      <h3 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white">
        {featuredProject.title}
      </h3>
      <span class="px-3 py-1.5 rounded-full bg-[#00288E]/10 text-[#00288E] dark:text-blue-300 dark:bg-blue-900/40 text-xs sm:text-sm font-semibold">
        {featuredProject.tag}
      </span>
    </div>

    <p class="text-[#64748b] dark:text-slate-400 text-base sm:text-lg leading-relaxed mb-8">
      {featuredProject.description}
    </p>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {featuredProject.stats.map((stat) => (
        <div class="bg-[#f8fafc] dark:bg-slate-800/60 rounded-2xl p-5 border border-slate-100 dark:border-slate-800/80">
          <h4 class="text-2xl sm:text-3xl font-bold text-[#00288E] dark:text-blue-400 mb-1">
            {stat.value}
          </h4>
          <p class="text-xs sm:text-sm text-[#64748b] dark:text-slate-400 font-medium">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
