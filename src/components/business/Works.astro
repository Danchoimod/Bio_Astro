---
import Icon from '../Icon.astro';
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  links: BusinessBioConfig['links'];
}

const { links } = Astro.props;
const categories = Array.from(new Set(links.map((link) => link.category)));
---

<section id="works" class="py-16 md:py-24 px-6 bg-[#f7f9fa] dark:bg-white/[0.03] transition-colors duration-300">
  <div class="max-w-[1160px] mx-auto space-y-10">
    <div>
      <h2 class="font-['Plus_Jakarta_Sans',sans-serif] font-bold text-2xl md:text-4xl text-black dark:text-white mb-3">
        Dự án & Liên kết tiêu biểu
      </h2>
      <p class="text-sm md:text-base text-[#434655] dark:text-white/60">
        Danh mục các sản phẩm công nghệ, repo mã nguồn mở và kênh kết nối.
      </p>
    </div>

    <div class="space-y-10">
      {categories.map((cat) => (
        <div class="space-y-4">
          <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-[#0061ff] dark:text-[#cad3ff] pl-1">
            {cat}
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {links
              .filter((l) => l.category === cat)
              .map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-6 bg-white dark:bg-black border border-black/10 dark:border-white/10 hover:border-[#0061ff] dark:hover:border-[#0061ff] rounded-2xl transition-all duration-200 group flex items-start justify-between shadow-sm hover:shadow-md"
                >
                  <div class="space-y-2 pr-4">
                    <div class="flex items-center gap-2">
                      <h4 class="font-['Plus_Jakarta_Sans',sans-serif] font-bold text-base text-black dark:text-white group-hover:text-[#0061ff] transition-colors">
                        {link.title}
                      </h4>
                      {link.featured && (
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-500/10 text-[#0061ff] border border-blue-500/20">
                          Featured
                        </span>
                      )}
                    </div>
                    <p class="text-xs sm:text-sm text-[#434655] dark:text-white/60 leading-relaxed">
                      {link.description}
                    </p>
                  </div>
                  <div class="w-9 h-9 rounded-xl bg-[#f7f9fa] dark:bg-white/5 border border-black/5 dark:border-white/10 flex items-center justify-center text-[#434655] dark:text-white/70 group-hover:text-[#0061ff] group-hover:border-[#0061ff]/30 transition-colors shrink-0">
                    <Icon name={link.icon} className="w-4 h-4" />
                  </div>
                </a>
              ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
