---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  businessData: BusinessBioConfig;
}

const { businessData } = Astro.props;
---

<header class="pt-24 pb-20">
  <div class="space-y-6">
    <!-- Top Bar with Badge + Theme / Switcher -->
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-[#00288E]/10 text-[#00288E] dark:text-blue-300 dark:bg-blue-900/40 text-sm font-semibold">
        <span>{businessData.badge}</span>
      </div>

      <!-- Dark / Light Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle Theme"
        class="w-10 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition cursor-pointer shadow-xs"
      >
        <svg id="theme-icon-dark" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-light" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl font-extrabold text-[#0f172a] dark:text-white leading-[1.1] tracking-tight">
      Hi, I'm {businessData.name}
    </h1>

    <!-- Summary Paragraph -->
    <p class="max-w-[700px] text-[#64748b] dark:text-slate-400 text-lg sm:text-xl leading-relaxed">
      {businessData.summary}
    </p>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3 flex-wrap pt-2">
      <a
        href="#project"
        class="px-5 py-3.5 rounded-xl bg-[#00288E] hover:bg-[#002072] text-white font-semibold text-sm sm:text-base transition-colors shadow-xs"
      >
        View Project
      </a>
      <a
        href="https://github.com/Danchoimod"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-3.5 rounded-xl bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 text-[#0f172a] dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 font-semibold text-sm sm:text-base transition-colors shadow-xs"
      >
        GitHub
      </a>
    </div>
  </div>
</header>
