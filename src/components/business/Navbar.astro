---
import Icon from "../Icon.astro";
import type { BusinessBioConfig } from "../../data/business";

interface Props {
  businessData: BusinessBioConfig;
}

const { businessData } = Astro.props;
---

<nav
  class="fixed w-full top-0 z-50 bg-white/80 dark:bg-black/80 backdrop-blur-md border-b border-black/5 dark:border-white/5 transition-colors duration-300"
>
  <div
    class="flex justify-between items-center h-16 px-6 max-w-[1160px] mx-auto"
  >
    <a href="/" class="flex items-center gap-3">
      <div
        class="w-8 h-8 rounded-lg bg-[#0061ff] flex items-center justify-center font-extrabold text-white text-sm shadow-md shadow-blue-500/20"
      >
        {businessData.name.slice(0, 2).toUpperCase()}
      </div>
      <span
        class="text-base md:text-lg font-bold text-black dark:text-white tracking-tight font-['Plus_Jakarta_Sans',sans-serif]"
      >
        {businessData.name}
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm font-semibold">
      <a
        class="text-[#434655] dark:text-white/70 hover:text-[#0061ff] dark:hover:text-[#cad3ff] transition-colors"
        href="#intro"
      >
        Giới thiệu
      </a>
      <a
        class="text-[#434655] dark:text-white/70 hover:text-[#0061ff] dark:hover:text-[#cad3ff] transition-colors"
        href="#works"
      >
        Dự án & Liên kết
      </a>
      <a
        class="text-[#434655] dark:text-white/70 hover:text-[#0061ff] dark:hover:text-[#cad3ff] transition-colors"
        href="#skills"
      >
        Kỹ năng
      </a>
      <a
        class="text-[#434655] dark:text-white/70 hover:text-[#0061ff] dark:hover:text-[#cad3ff] transition-colors"
        href="#experience"
      >
        Kinh nghiệm
      </a>
    </div>

    <div class="flex items-center gap-2">
      <!-- Dark/Light Mode Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle Dark Mode"
        class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-slate-700 dark:text-slate-200 cursor-pointer"
      >
        <svg
          id="theme-icon-dark"
          class="w-5 h-5 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="theme-icon-light"
          class="w-5 h-5 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</nav>
