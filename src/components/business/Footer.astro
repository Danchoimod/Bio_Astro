---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  businessData: BusinessBioConfig;
}

const { businessData } = Astro.props;
---

<footer class="py-16 border-t border-[#e2e8f0] dark:border-slate-800">
  <div class="flex items-center justify-between flex-wrap gap-6 text-sm">
    <div>
      <h3 class="font-bold text-base text-[#0f172a] dark:text-white">
        {businessData.name}
      </h3>
      <p class="text-[#64748b] dark:text-slate-400">
        {businessData.headline}
      </p>
    </div>

    <div class="text-left sm:text-right space-y-1 text-[#64748b] dark:text-slate-400">
      <p>GitHub: <a href={`https://${businessData.github}`} target="_blank" rel="noopener noreferrer" class="hover:text-[#00288E] dark:hover:text-blue-400 font-medium">{businessData.github}</a></p>
      <p>{businessData.location}</p>
    </div>
  </div>
</footer>
