---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  experience: BusinessBioConfig['experience'];
  philosophy: BusinessBioConfig['philosophy'];
}

const { experience, philosophy } = Astro.props;
---

<!-- Experience Section -->
<section class="mb-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white mb-6 tracking-tight">
    Experience
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {experience.map((exp) => (
      <div class="bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xs">
        <h3 class="font-bold text-lg text-[#0f172a] dark:text-white mb-1">
          {exp.role}
        </h3>
        <p class="text-sm font-semibold text-[#00288E] dark:text-blue-400 mb-3">
          {exp.company}
        </p>
        <p class="text-sm text-[#64748b] dark:text-slate-400 leading-relaxed">
          {exp.description}
        </p>
      </div>
    ))}
  </div>
</section>

<!-- Development Philosophy Section -->
<section class="mb-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white mb-6 tracking-tight">
    Development Philosophy
  </h2>

  <div class="bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xs space-y-3">
    <h3 class="font-bold text-lg sm:text-xl text-[#00288E] dark:text-blue-400">
      {philosophy.title}
    </h3>
    <p class="text-base text-[#64748b] dark:text-slate-400 leading-relaxed">
      {philosophy.description}
    </p>
  </div>
</section>
