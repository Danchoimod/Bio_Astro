---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  skills: BusinessBioConfig['skills'];
}

const { skills } = Astro.props;
---

<section id="skills" class="py-16 md:py-24 px-6 max-w-[1160px] mx-auto">
  <div class="space-y-6">
    <div>
      <h2 class="font-['Plus_Jakarta_Sans',sans-serif] font-bold text-2xl md:text-4xl text-black dark:text-white mb-3">
        Kỹ thuật & Công nghệ
      </h2>
      <p class="text-sm md:text-base text-[#434655] dark:text-white/60">
        Các ngôn ngữ, công cụ và framework được sử dụng trong quá trình phát triển.
      </p>
    </div>

    <div class="flex flex-wrap gap-3 pt-2">
      {skills.map((skill) => (
        <span class="px-4 py-2.5 rounded-xl bg-[#f7f9fa] dark:bg-white/5 border border-black/10 dark:border-white/10 hover:border-[#0061ff] dark:hover:border-[#0061ff] text-black dark:text-white text-xs sm:text-sm font-semibold font-mono transition-colors">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
