---
import type { BusinessBioConfig } from '../../data/business';

interface Props {
  skills: BusinessBioConfig['skills'];
}

const { skills } = Astro.props;
---

<section class="mb-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-[#0f172a] dark:text-white mb-6 tracking-tight">
    Technical Skills
  </h2>

  <div class="flex flex-wrap gap-2.5">
    {skills.map((skill) => (
      <div class="px-3.5 py-2.5 bg-white dark:bg-slate-900 border border-[#e2e8f0] dark:border-slate-800 rounded-xl text-sm font-medium text-[#0f172a] dark:text-slate-200 shadow-xs hover:border-[#00288E] dark:hover:border-blue-400 transition-colors">
        {skill}
      </div>
    ))}
  </div>
</section>
